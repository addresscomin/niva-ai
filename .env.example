# ---- AI keys (free tier wale bhi chalenge). Multiple keys comma se: key1,key2 ----
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-sonnet-4-6

# ---- Limits ----
DAILY_CLIP_LIMIT=20        # har user ka roz ka clips limit (quarter/monthly limit nahi)
MAX_CLIPS_PER_JOB=20
CLIP_MIN_SEC=10
CLIP_MAX_SEC=120
WORKERS=1
WHISPER_MODEL=small        # lambi stream ke liye tiny/base bhi le sakte ho (speed)
MAX_UPLOAD_MB=2048

# ---- Server ----
DATA_DIR=data
COOKIE_SECURE=0            # HTTPS par 1 karo
YT_COOKIES_FILE=           # YouTube block ho to apne browser ki cookies.txt path

# ---- Hindi dubbing (BETA) ----
DUBBING_ENABLED=0
DUB_VOICE=hi-IN-SwaraNeural

# ---- Authentication providers ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://reelforge-ai-dhbx.onrender.com/auth/google/callback
PUBLIC_BASE_URL=https://reelforge-ai-dhbx.onrender.com

# ---- Password recovery email (SMTP) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

